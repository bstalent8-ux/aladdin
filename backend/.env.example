# Backend (FastAPI AI/document service) environment. Copy to `.env` and fill in.
# Read ONLY through app/config.py (Pydantic Settings). Never commit `.env`.
# See docs/security/secrets-and-environments.md.

# local | staging | production. In staging/production the app fails fast if the
# required Supabase secrets below are missing (no silent defaults for secrets).
# Exposure: config | Required
APP_ENV=local

# --- Supabase --------------------------------------------------------------
# Exposure: config | Required (staging/prod)
SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon key — used for USER-scoped clients that preserve the caller JWT so
# RLS applies (app/database.create_user_client). Public by exposure level.
# Exposure: config | Required (staging/prod)
SUPABASE_ANON_KEY=your-anon-publishable-key
# Exposure: SECRET | Required (staging/prod) — server-only, never sent to a browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
# Exposure: SECRET | Required (staging/prod) — used to verify Supabase JWTs
SUPABASE_JWT_SECRET=your-jwt-secret

# Direct Postgres connection string for trusted-worker / RPC / tooling use.
# Python data access is via supabase-py (ADR-0005); schema is owned by
# supabase/migrations and is never created from app code (ADR-0002).
# Use the DIRECT connection (host: db.<ref>.supabase.co), not the pooler.
# Exposure: SECRET | Required (staging/prod)
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# --- OpenAI ----------------------------------------------------------------
# Exposure: SECRET | Optional until the LLM/embedding layer is wired
OPENAI_API_KEY=sk-your-openai-api-key
# Exposure: config | Optional
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Server ----------------------------------------------------------------
# Comma-separated browser origins allowed to call the API (CORS).
# Next.js dev server runs on port 3000.
# Exposure: config | Required
ALLOWED_ORIGINS=http://localhost:3000

# Optional Redis for background-job locks (ADR-0019). Unset: jobs run unlocked
# (they are idempotent). Exposure: SECRET. Hosted must be rediss:// (TLS).
REDIS_URL=
REDIS_KEY_ENV=

# --- R2 (video transcode worker only, ADR-0020) ---
# A token scoped to the PRIVATE bucket. The API service does not need these.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
# Isolated local tests only; refused unless APP_ENV=local.
R2_LOCAL_S3_ENDPOINT=
