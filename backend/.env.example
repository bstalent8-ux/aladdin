# Backend (FastAPI AI/document service) environment. Copy to `.env` and fill in.
# Read ONLY through app/config.py (Pydantic Settings). Never commit `.env`.
# See docs/security/secrets-and-environments.md.

# local | staging | production. Optional: on Vercel it is derived from VERCEL_ENV
# (Production -> production, Preview -> staging) and `local` is ignored there.
# Outside local, a missing required variable below makes /api/backend/health answer
# 503 "misconfigured" and every authenticated endpoint refuse (the process stays up).
# Vercel names per environment: docs/guides/vercel-environment-variables.md
# Exposure: config | Optional
APP_ENV=local

# --- Supabase --------------------------------------------------------------
# Exposure: config | Required (staging/prod)
SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon key — used for USER-scoped clients that preserve the caller JWT so
# RLS applies (app/database.create_user_client). Public by exposure level.
# Exposure: config | Required (staging/prod)
SUPABASE_ANON_KEY=your-anon-publishable-key
# Exposure: SECRET | Operator jobs only (historical media purge); not set on Vercel
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
# Exposure: SECRET | Optional — legacy HS256 tokens only; ES256 tokens verify via JWKS
SUPABASE_JWT_SECRET=your-jwt-secret

# Direct Postgres connection string for trusted-worker / RPC / tooling use.
# Python data access is via supabase-py (ADR-0005); schema is owned by
# supabase/migrations and is never created from app code (ADR-0002).
# Use the DIRECT connection (host: db.<ref>.supabase.co), not the pooler.
# Exposure: SECRET | Optional — read by no code today; not set on Vercel
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# --- OpenAI ----------------------------------------------------------------
# Exposure: SECRET | Optional until the LLM/embedding layer is wired
OPENAI_API_KEY=sk-your-openai-api-key
# Exposure: config | Optional
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Server ----------------------------------------------------------------
# Comma-separated browser origins allowed to call the API (CORS).
# Next.js dev server runs on port 3000.
# Exposure: config | Required
ALLOWED_ORIGINS=http://localhost:3000
