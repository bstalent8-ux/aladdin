{
  // Video transcode worker on Cloudflare Containers (ADR-0020, evaluation in
  // docs/architecture/video-transcode-cloudflare-containers.md). NOT deployed:
  // every hosted step needs owner approval, and video stays off (VIDEO_ENABLED=false).
  //
  // Separate from the FastAPI API container: its own Worker, image and Durable
  // Object class. No route, no workers.dev URL: it is reached only by its cron
  // and by a service binding (`wake()`).
  //
  // Secrets are never written here. Per environment:
  //   wrangler secret put SUPABASE_URL | SUPABASE_SERVICE_ROLE_KEY | R2_ACCOUNT_ID
  //                       R2_ACCESS_KEY_ID | R2_SECRET_ACCESS_KEY | R2_PRIVATE_BUCKET
  // R2_ACCESS_KEY_ID/SECRET: a token scoped to the private bucket only.
  "name": "aladdin-video-transcode",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // A safety net: picks up expired leases and retries, and runs the purge.
  // New uploads should call wake() through a service binding instead of waiting.
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": {
    "APP_ENV": "staging",
    // Parallel transcodes at most; keep equal to max_instances below.
    "TRANSCODE_SLOTS": "2"
  },
  "containers": [
    {
      "class_name": "TranscodeSlot",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      // 2 vCPU / 6 GiB (the minimum memory for 2 vCPU) / 20 GB disk (the
      // default maximum). ffmpeg peaked at ~0.6 GiB RSS for 1080p in three
      // renditions; the disk bounds the largest original (~2.5x rule).
      "instance_type": { "vcpu": 2, "memory_mib": 6144, "disk_mb": 20000 },
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "TRANSCODE", "class_name": "TranscodeSlot" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TranscodeSlot"] }]
}
