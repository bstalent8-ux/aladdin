# ==========================================================================
# Aladdin — repository ignore rules
# Goal: keep secrets, large binaries, AI-agent artifacts, and generated
# output out of (a potentially public) Git history. Source files, scoped
# AGENTS.md docs, ADRs, and .env.example templates are intentionally tracked.
# ==========================================================================

# --- Secrets & environments -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/
# `vercel link` writes the project link here and pulls an OIDC token into it.
.vercel/

# --- AI-agent & tooling artifacts (must never enter a public repo) ----------
.claude/
.codex/
.impeccable/
.cursor/
.aider*
**/scratchpad/
*.agent.log
agent-logs/
transcripts/
# Generic logs & session transcripts (agent output must never enter history)
logs/
*.log
*.transcript

# --- Pencil design files ----------------------------------------------------
# Canonical + backups are large private design IP. They live on disk and are
# versioned out-of-band (see UI-UX/AGENTS.md). Never commit to public history.
*.pen

# --- Node / Next.js ---------------------------------------------------------
node_modules/
.pnp.*
.next/
# Extra build folders for side-by-side production builds (performance and review runs); never source.
.next-perf/
.next-review/
out/
build/
dist/
*.tsbuildinfo
.turbo/
.cache/
.eslintcache
# Enforce pnpm: no competing lockfiles
package-lock.json
yarn.lock

# --- Python / FastAPI -------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
# Enforce uv: no competing lockfiles / requirements
requirements*.txt

# --- Supabase ---------------------------------------------------------------
supabase/.branches/
supabase/.temp/
.supabase/
# Assembled by scripts/build_staging_seed.py — build artifacts, not source.
# The cloud one carries REAL demo email addresses; the manifests carry them too.
supabase/.staging-seed.sql
supabase/.staging-seed.rehearsal.sql
supabase/.staging-demo-manifest.md
supabase/.staging-demo-manifest.csv
# Names a real mailbox. The committed template is demo-email.example.toml.
supabase/staging/demo-email.toml

# --- Data & generated artifacts (business/customer data never committed) ----
data/imports/*
!data/imports/.gitkeep
data/samples/*
!data/samples/.gitkeep
data/downloads/
*.ocr.json
*.embeddings.*
*.vecdump
/tmp/generated-pdfs/
# Local temporary exports (runtime exports go to the Supabase `exports/` bucket)
/tmp/exports/

# --- OS / IDE ---------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# --- Test / coverage --------------------------------------------------------
coverage/
htmlcov/
.coverage
playwright-report/
test-results/

# Cloudflare Workers build (OpenNext / wrangler)
.open-next/
.wrangler/
.dev.vars*
!.dev.vars.example
cloudflare-env.d.ts
