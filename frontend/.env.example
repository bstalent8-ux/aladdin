# Frontend environment (Next.js). Copy to `.env.local` and fill in.
# Rules: only NEXT_PUBLIC_* is exposed to the browser; everything else is
# server-only. All values are read through src/lib/env — never process.env
# directly. See docs/security/secrets-and-environments.md.

# The full per-environment matrix (which value goes where in Vercel/Supabase)
# lives in docs/operations/staging-deployment-runbook.md.

# --- Public (safe to expose to the browser) ---------------------------------
# Exposure: PUBLIC | Required — `local` here, `staging` on the Vercel staging project
NEXT_PUBLIC_APP_ENV=local
# Exposure: PUBLIC | Required — from `pnpm supabase status` (local) or the dashboard
# (staging: https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Exposure: PUBLIC | Required — anon/publishable key (RLS-constrained, browser-safe)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
# Exposure: PUBLIC | Optional — approved support contact shown on /auth/support
# (email or help-desk URL). Leave unset to show a safe "unavailable" state; never
# hard-code a fabricated contact.
NEXT_PUBLIC_SUPPORT_CONTACT=
# Exposure: PUBLIC | Optional — Cloudflare Turnstile SITE key (not a secret —
# meant to be embedded in the page). Canonical password auth's Create Account
# (+ resend code) and Forgot Password request, and the installer sign-up,
# render the widget; Sign In has NO CAPTCHA. Leave unset locally to fall back to Cloudflare's published
# always-pass TEST site key. Staging/production need a real site key from the
# Cloudflare dashboard, paired with TURNSTILE_SECRET_KEY below. CAPTCHA is
# APPLICATION-SCOPED: the app verifies every token with Cloudflare Siteverify;
# Supabase's global [auth.captcha] stays OFF (never configure a secret there).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Server-only (NEVER exposed to the browser) -----------------------------
# Exposure: SECRET | Required in staging/production (canonical `/auth/*` Create
# Account / Forgot Password and `/installer/sign-up` are live) — the Cloudflare
# Turnstile SECRET key paired with NEXT_PUBLIC_TURNSTILE_SITE_KEY. Server-only,
# never NEXT_PUBLIC_*. Read solely by src/server/auth/turnstile.ts, which calls
# Cloudflare Siteverify before Supabase Auth is invoked. Unset is allowed ONLY
# locally (falls back to Cloudflare's always-pass TEST secret); anywhere else
# an unset secret makes every CAPTCHA check fail closed.
TURNSTILE_SECRET_KEY=
# Exposure: SECRET | Required in staging/production for authentication — every
# product query still runs as the caller under RLS (ADR-0007); the only
# Auth service-role caller is `lib/supabase/admin-server.ts`, used by canonical
# password auth (`server/actions/auth-password-preview.ts` — writes the
# `app_metadata` password-state flag and stages pending registrations; see
# docs/frontend/auth-password-preview.md §Authoritative password-state
# tracking) and installer phone auth (`server/actions/installer-phone-auth.ts`).
# Optional in the schema only so unrelated local tooling can boot without it.
SUPABASE_SERVICE_ROLE_KEY=
# Media also requires this server-only key for byte verification, trusted receipts
# and private Storage IO AFTER caller-scoped authorization. Never use it for
# product or organization authorization or expose it to the browser.

# Server-only media routing. Both flags MUST remain false until separately approved.
# Existing explicit R2 references remain readable when routing is disabled.
R2_STORAGE_ENABLED=false
R2_PRODUCTION_WRITES_APPROVED=false
# Server-only; required for R2 reads/writes when configured. Bucket-scoped token.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
# Optional approved immutable public media only; NOT product/logo/private assets.
R2_PUBLIC_BASE_URL=
# Server-only edge delivery through the media Worker (edge/media-worker). MUST stay
# false until the hosted Worker is separately approved; the app proxy serves media
# while false. Only R2-provider rows ever get edge URLs.
MEDIA_EDGE_DELIVERY_ENABLED=false
# Mode C (published portfolio / listed avatars) through the Worker; true by default
# once edge delivery is on. Set false to keep public media on /p/media.
MEDIA_EDGE_PUBLIC_ENABLED=false
# Public: the Worker's HTTPS origin, e.g. https://media.example.com (no path).
MEDIA_EDGE_ORIGIN=
# Key id of the current ticket key (lowercase letters/digits, max 16).
MEDIA_EDGE_TICKET_KID=
# Exposure: SECRET | Required when edge delivery is on. base64url, 32+ bytes; the
# same value is a Worker secret (TICKET_KEYS). Generate locally with:
# python3 -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).rstrip(b'=').decode())"
MEDIA_EDGE_TICKET_SECRET=
# Optional Redis accelerator (ADR-0019): reference-vocabulary cache and per-user
# rate limits. Never an authorization input and never stores media bytes. With it
# false, reads go to Postgres and rate limits count per instance in memory.
# Setup: docs/guides/upstash-setup.md.
REDIS_CACHE_ENABLED=false
# Exposure: SECRET | redis://127.0.0.1:6379 locally; hosted must be rediss:// (TLS).
# Upstash: the TCP URL rediss://default:<password>@<name>.upstash.io:6379 (database 0).
# TCP is used on Vercel/Node only; on Cloudflare Workers it is refused (Redis then
# counts as unavailable and the fallbacks apply). Set the REST pair below there.
REDIS_URL=
# Upstash REST transport (one HTTPS request per command, no connection). When both
# are set they win over REDIS_URL. Required for Redis on Cloudflare Workers.
# Exposure: server-only | https://<name>.upstash.io (http:// only with APP_ENV=local).
REDIS_REST_URL=
# Exposure: SECRET | the database's REST token (not the read-only one).
REDIS_REST_TOKEN=
# Optional key prefix when several environments share one Redis database.
REDIS_KEY_ENV=
# Optional. Monthly command allowance for the usage warnings (default 500000, Upstash Free).
REDIS_MONTHLY_COMMAND_BUDGET=
# Exposure: SECRET | Required in staging/production — symmetric key (32+ bytes)
# for canonical Forgot Password's recovery-grant cookie (AES-256-GCM,
# lib/supabase/recovery-grant.ts). The historical `PREVIEW` in the name is kept
# so hosted environment variables need no change. Generate
# locally with: python3 -c "import secrets; print(secrets.token_hex(32))"
AUTH_PASSWORD_PREVIEW_GRANT_SECRET=
# Exposure: SECRET | Optional — base URL of the FastAPI AI/document service.
# The web app makes no HTTP call to it, so it is NOT deployed for staging. Leave
# unset unless you are running backend/ locally.
AI_SERVICE_URL=http://localhost:8000

# Exposure: PUBLIC | Optional — release gate for the landing page "Aladdin Marketplace" announcement
# section (sample data only, ADR-0011). Only the exact value "true" shows it; unset/false
# (Production default) leaves the landing page unchanged.
NEXT_PUBLIC_MARKETPLACE_PREVIEW=

# --- Video (ADR-0020) ---
# Portfolio and product videos: browser -> private R2 (multipart), HLS from the media
# Worker only. Requires R2_STORAGE_ENABLED and MEDIA_EDGE_DELIVERY_ENABLED; there is
# no proxy fallback, so with either off no video plays.
VIDEO_ENABLED=false
# Isolated local tests only (S3-compatible stand-in for R2). Refused unless
# NEXT_PUBLIC_APP_ENV=local. Never set in a deployed environment.
R2_LOCAL_S3_ENDPOINT=
