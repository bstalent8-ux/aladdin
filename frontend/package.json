{
  "name": "@aladdin/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "cf:build": "node scripts/build-cloudflare.mjs",
    "cf:dev": "wrangler dev --port 8787",
    "cf:preview:deploy": "wrangler deploy --env preview",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:staging-smoke": "playwright test -c playwright.staging-smoke.config.ts",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@floating-ui/react-dom": "^2.1.9",
    "@redis/client": "6.3.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.48.1",
    "hls.js": "1.7.3",
    "libphonenumber-js": "^1.13.14",
    "motion": "^13.1.1",
    "next": "^16.4.2",
    "pdf-lib": "1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-easy-crop": "^6.2.3",
    "server-only": "0.0.1",
    "sharp": "0.34.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "@playwright/test": "^1.49.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.4.2",
    "happy-dom": "^20.11.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "wrangler": "4.151.2"
  }
}
