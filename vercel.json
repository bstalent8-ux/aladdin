{
  "regions": ["cdg1"],
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "runtime": "python",
      "entrypoint": "app/main.py"
    }
  },
  "images": {
    "sizes": [
      16, 32, 48, 64, 96, 128, 256, 384,
      640, 750, 828, 1080, 1200, 1920, 2048, 3840
    ],
    "qualities": [25, 50, 75, 100],
    "formats": ["image/webp"],
    "minimumCacheTTL": 60
  },
  "rewrites": [
    {
      "source": "/api/backend(/.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
