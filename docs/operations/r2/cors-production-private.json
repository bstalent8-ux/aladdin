{
  "rules": [
    {
      "id": "browser-direct-upload",
      "allowed": {
        "origins": [
          "https://aladdindecore.com",
          "https://www.aladdindecore.com",
          "https://next.aladdindecore.com"
        ],
        "methods": ["PUT"],
        "headers": ["content-type", "content-length"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
