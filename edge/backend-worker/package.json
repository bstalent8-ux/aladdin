{
  "name": "@aladdin/backend-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker that runs the FastAPI backend (backend/Dockerfile) in a Cloudflare Container, reached only through a service binding from the frontend Worker.",
  "scripts": {
    "typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "vitest run",
    "typecheck": "pnpm typegen && tsc --noEmit",
    "bundle": "wrangler deploy --env preview --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "wrangler": "4.151.2"
  }
}
